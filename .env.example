# Neon pooled connection string (required on Vercel)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# WhatsApp number for order confirmation links (digits only, with country code)
NEXT_PUBLIC_WHATSAPP_NUMBER=923001234567

# Admin seed (optional; defaults shown)
ADMIN_EMAIL=owner@garmentloop.store
ADMIN_PASSWORD=GarmentLoop-Owner-2026

# Show customer OTP codes in the login UI (enabled automatically outside production)
# AUTH_SHOW_OTP=1

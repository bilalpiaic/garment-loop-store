# OPTIONAL locally — app runs fully without a database (in-memory/file demo seed).
# Postgres/Neon (Vercel default): postgresql://...
# MySQL/MariaDB (cPanel): mysql://USER:PASSWORD@localhost:3306/DBNAME
# Or set MYSQL_HOST + MYSQL_USER + MYSQL_PASSWORD + MYSQL_DATABASE (+ MYSQL_PORT).
# Then run: npm run db:migrate
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
# DATABASE_URL=mysql://USER:PASSWORD@localhost:3306/garmentloop21_store
# MYSQL_HOST=localhost
# MYSQL_USER=
# MYSQL_PASSWORD=
# MYSQL_DATABASE=
# MYSQL_PORT=3306

# WhatsApp number for order confirmation links (digits only, with country code)
NEXT_PUBLIC_WHATSAPP_NUMBER=923001234567

# Marketing analytics (optional). Leave empty for safe no-ops.
# Scripts load only after the shopper accepts the consent banner.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_META_PIXEL_ID=123456789012345

# Admin seed — required on first boot when no admin users exist.
# Set a strong unique password; never commit real values.
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=replace-with-a-strong-unique-password

# Require TOTP MFA for owner/admin at login (staff optional).
# When on, owner/admin without MFA enroll at first password login, then verify on later logins.
# Production should set ADMIN_MFA_REQUIRED=1.
# ADMIN_MFA_REQUIRED=1

# Show customer OTP codes in the login UI (enabled automatically outside production)
# AUTH_SHOW_OTP=1

# Allow sandbox card_demo checkout in production (default: off when NODE_ENV=production)
# ALLOW_CARD_DEMO=1

# Public site origin for canonicals, sitemap, Open Graph, and email links.
# Production: https://garmentloop.com (falls back to site.url in src/lib/site.ts)
# NEXT_PUBLIC_SITE_URL=https://garmentloop.com

# Stripe (optional). When both are set, checkout offers Card · wallets · BNPL
# via Payment Element + Express Checkout. Without them, COD / bank remain (card_demo only outside production).
# Enable Klarna / Afterpay / wallets in the Stripe Dashboard — do not invent keys.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Webhook signing secret for POST /api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# Circular wardrobe subscriptions (Phase 3). Without Stripe keys, signup activates a
# mock membership so the storefront works locally. Force mock even with Stripe:
# CIRCULAR_SUBSCRIPTIONS_MOCK=1
CIRCULAR_SUBSCRIPTIONS_MOCK=
# Optional Stripe Price IDs (Billing). When unset, Checkout uses price_data from plan PKR→USD.
# STRIPE_PRICE_CARE_MONTHLY=
# STRIPE_PRICE_REPAIR_PLUS_MONTHLY=
# STRIPE_PRICE_RECYCLE_LOOP_MONTHLY=

# Transactional email (optional). Prefer Resend; otherwise SMTP.
# Used for order/shipment/return notices AND customer login OTP (/account/login).
# Without either, emails are logged to the server console (mock mode).
# On Vercel production, set one of these so shoppers receive OTP codes by email.
RESEND_API_KEY=
# Resend onboarding@resend.dev only delivers to the Resend account owner.
# After domain verify: EMAIL_FROM="GarmentLoop <orders@garmentloop.store>"
# EMAIL_FROM="GarmentLoop <onboarding@resend.dev>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# SMTP_SECURE=1

# Live shipping rates via EasyPost (optional). Without these, checkout uses zone rates.
# Never commit real keys. Test keys work for rating in EasyPost test mode.
# EASYPOST_API_KEY=
# Ship-from (required together with the API key for live rates):
# EASYPOST_FROM_NAME=GarmentLoop
# EASYPOST_FROM_STREET1=12 Atelier Lane
# EASYPOST_FROM_CITY=Lahore
# EASYPOST_FROM_STATE=PB
# EASYPOST_FROM_ZIP=54000
# EASYPOST_FROM_COUNTRY=PK
# EASYPOST_FROM_PHONE=+923001234567

# Tax engine (optional). Without these, checkout uses local PK/GCC/intl estimates.
# Avalara AvaTax (preferred when both account + license are set):
# AVALARA_ACCOUNT_ID=
# AVALARA_LICENSE_KEY=
# AVALARA_COMPANY_CODE=DEFAULT
# AVALARA_ENV=sandbox
# TaxJar (used when Avalara is unset):
# TAXJAR_API_KEY=
# TAXJAR_ENV=sandbox
# TAXJAR_FROM_COUNTRY=US
# TAXJAR_FROM_ZIP=
# TAXJAR_FROM_STATE=
# TAXJAR_FROM_CITY=

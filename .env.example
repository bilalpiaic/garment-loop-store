# Neon pooled connection string (required on Vercel)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# WhatsApp number for order confirmation links (digits only, with country code)
NEXT_PUBLIC_WHATSAPP_NUMBER=923001234567

# Admin seed (optional; defaults shown)
ADMIN_EMAIL=owner@garmentloop.store
ADMIN_PASSWORD=GarmentLoop-Owner-2026

# --- Customer OTP (email or SMS) ---
# Follow docs/otp-setup.md. Without these keys, development shows a preview code
# and production refuses to send.

# Email OTP via Resend — https://resend.com/api-keys
RESEND_API_KEY=
EMAIL_FROM=GarmentLoop <hello@yourdomain.com>

# SMS OTP via Twilio — https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Show the OTP in the login UI (default: on in development, off in production)
# AUTH_SHOW_OTP=true

# Product image uploads on Vercel — https://vercel.com/docs/storage/vercel-blob
# Local `npm run dev` saves files under public/uploads. On Vercel, set:
# BLOB_READ_WRITE_TOKEN=
